PROFILE_DESCRIPTION="Q3_K_XL on NVLink pair 2-3 without speculative decoding"
BACKEND=llama.cpp

HF_REPO=unsloth/Qwen3.8-Flash-Next-GGUF
MODEL_DIR=/home/algore/models/qwen3.8-flash-next-q3xl-gguf
MODEL=$MODEL_DIR/UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00001-of-00003.gguf
DOWNLOAD_PATTERNS="UD-Q3_K_XL/*.gguf"

CUDA_VISIBLE_DEVICES=2,3
TENSOR_SPLIT=1,1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
CHAT_TEMPLATE_KWARGS='{"reasoning_effort":"medium"}'

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
