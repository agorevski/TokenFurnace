# Shared host defaults
HARDWARE_PROFILE=4x-rtx8000
SERVER_HOST=127.0.0.1

# Optional per-run overrides
# SERVER_PORT=8000
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.94
# PIPELINE_PARALLEL_SIZE=2      # vLLM: pipeline stages (pairs with TENSOR_PARALLEL_SIZE)
# MAX_NUM_SEQS=64               # vLLM: concurrency for aggregate throughput
# SPLIT_MODE=row                # llama.cpp: layer (default) or row
# CACHE_TYPE_K=q8_0             # llama.cpp: quantized KV cache
# CACHE_TYPE_V=q8_0

# Agent launchers
COPILOT_OFFLINE=true
