# Shared host defaults
HARDWARE_PROFILE=4x-rtx8000
SERVER_HOST=127.0.0.1

# Optional per-run overrides
# SERVER_PORT=8000
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.94
# PIPELINE_PARALLEL_SIZE=2      # vLLM: pipeline stages (pairs with TENSOR_PARALLEL_SIZE)
# MAX_NUM_SEQS=64               # vLLM: concurrency for aggregate throughput
# SPLIT_MODE=row                # llama.cpp: layer (default) or row
# CACHE_TYPE_K=q8_0             # llama.cpp: quantized KV cache
# CACHE_TYPE_V=q8_0

# Prompt/prefix caching (long coding-agent system prompts)
# llama.cpp (server defaults: cache-prompt on, cache-ram 8192, idle slots on):
# CACHE_RAM_MIB=32768           # host-RAM prompt cache size in MiB (-1 = no limit)
# CACHE_REUSE=256               # min chunk size for partial-prefix KV reuse (0 = off)
# SLOT_PROMPT_SIMILARITY=0.01   # low value keeps a single interactive slot warm
# ENABLE_METRICS=1              # expose Prometheus /metrics for cache-hit checks
# CACHE_PROMPT=0                # set 0 to disable prompt caching (e.g. benchmarks)
# CACHE_IDLE_SLOTS=0            # set 0 to disable saving idle slots to the cache
# vLLM automatic prefix caching (off by default for the Qwen3-Next hybrid model):
# ENABLE_PREFIX_CACHING=1       # enable APC
# MAMBA_CACHE_MODE=align        # required Mamba cache mode (experimental)
# PREFIX_CACHING_HASH_ALGO=sha256
# BLOCK_SIZE=16                 # only if a runtime with 16-token blocks is validated

# Agent launchers
COPILOT_OFFLINE=true
