# NVIDIA Quadro RTX 8000 workstation hardware profile.
#
# Machine-readable snapshot of the host used by every model target. Values are
# sourced into the environment by scripts/lib/common.sh, so every line must be a
# valid shell assignment. Scripts consume the first block; the remaining blocks
# document topology and installed software for reproducibility. Unknown values
# are left empty rather than guessed.

# --- Consumed by scripts -----------------------------------------------------
GPU_COUNT=4
GPU_MEMORY_MIB=49152
CUDA_ARCH=75
TENSOR_PARALLEL_SIZE=4
CUDA_VISIBLE_DEVICES=0,1,2,3
# GPU 0-1 and 2-3 are NVLink pairs; cross-pair traffic crosses PCIe host bridges.
GPU_TOPOLOGY=nvlink-pairs

# --- Provenance --------------------------------------------------------------
PROFILE_SNAPSHOT_DATE=2026-08-07
PROFILE_SNAPSHOT_SOURCE="nvidia-smi, nvidia-smi topo -m, nvidia-smi nvlink --status, lscpu, /etc/os-release, uname -r, nvcc --version"

# --- GPU -------------------------------------------------------------------
GPU_MODEL="NVIDIA Quadro RTX 8000"
GPU_ARCHITECTURE="Turing TU102"
GPU_COMPUTE_CAPABILITY=7.5
GPU_SM_ARCH=sm_75
GPU_MEMORY_GIB=48
GPU_MEMORY_TYPE=GDDR6
GPU_MEMORY_BANDWIDTH_GBPS=672
GPU_TENSOR_CORES_PER_GPU=576
GPU_MAX_SM_CLOCK_MHZ=2100
GPU_MAX_MEM_CLOCK_MHZ=7001
GPU_TDP_WATTS=260
GPU_POWER_LIMIT_WATTS=260
GPU_PERSISTENCE_MODE=disabled
GPU_ECC_MODE=disabled
GPU_VBIOS_VERSION=90.02.4A.00.01
GPU_BUS_IDS="0000:19:00.0,0000:1A:00.0,0000:67:00.0,0000:68:00.0"

# --- Aggregate GPU ---------------------------------------------------------
AGGREGATE_VRAM_GIB=192
AGGREGATE_VRAM_MIB=196608
AGGREGATE_MEMORY_BANDWIDTH_GBPS=2688

# --- Interconnect ----------------------------------------------------------
PCIE_GENERATION_MAX=3
PCIE_GENERATION_CURRENT=1
PCIE_LANES=16
NVLINK_TOPOLOGY="pairs: (0,1) and (2,3)"
NVLINK_LINKS_PER_PAIR=2
NVLINK_LINK_RATE_GBPS=25.781
NVLINK_PAIR_TOTAL_GBPS=51.562
CROSS_PAIR_PATH="PCIe host bridge (NODE), no NVLink"

# --- CPU / memory / NUMA ---------------------------------------------------
CPU_MODEL="Intel Xeon W-2295"
CPU_BASE_CLOCK_GHZ=3.00
CPU_SOCKETS=1
CPU_CORES=18
CPU_THREADS=36
NUMA_NODES=1
NUMA_NODE0_CPUS=0-35
SYSTEM_RAM_GIB=251
SYSTEM_RAM_NOMINAL_GIB=256

# --- OS / kernel -----------------------------------------------------------
OS_NAME="Ubuntu 24.04.4 LTS"
KERNEL_VERSION=6.8.0-137-generic
ARCH=x86_64

# --- Driver / CUDA / toolchain ---------------------------------------------
NVIDIA_DRIVER_VERSION=580.173.02
DRIVER_CUDA_COMPATIBILITY=13.0
GSP_FIRMWARE=gsp_tu10x.bin
CUDA_TOOLKIT_VERSION=12.4
NVCC_VERSION=12.4.131
GCC_VERSION=13.3.0
CMAKE_MIN_TESTED=3.28

# --- Storage / model directories -------------------------------------------
MODELS_ROOT=/home/algore/models
MODELS_FS_DEVICE=/dev/nvme0n1p2
MODELS_FS_SIZE=1.8T

# --- Installed inference environments --------------------------------------
CONDA_ROOT=/home/algore/miniconda3
# Conda base:  Python 3.13.9, PyTorch 2.11.0, CUDA 13.0, vLLM 0.21.0
# Conda vllm:  Python 3.11.15, PyTorch 2.10.0 (cu128), vLLM 0.17.1  <-- default
# Conda trt-llm: Python 3.12.13, PyTorch 2.5.1, CUDA 12.4, TensorRT-LLM not installed
VLLM_ENV_DEFAULT=/home/algore/miniconda3/envs/vllm
VLLM_VERSION_DEFAULT=0.17.1
VLLM_VERSION_BASE=0.21.0
LLAMA_CPP_DIR=/home/algore/llama.cpp-dspark-current
LLAMA_CPP_BUILD_DIR=/home/algore/llama.cpp-dspark-current/build-peer2048
LLAMA_CPP_COMMIT=15586e2d7165570fb3aa7c26e0d442e289ef69de
LLAMA_CPP_BUILD_TAG=b10298
