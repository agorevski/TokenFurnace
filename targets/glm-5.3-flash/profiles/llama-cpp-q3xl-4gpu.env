PROFILE_DESCRIPTION="Four-GPU UD-Q3_K_XL layer split"
BACKEND=llama.cpp

HF_REPO=unsloth/GLM-5.3-Flash-GGUF
MODEL_DIR=/home/algore/models/glm-5.3-flash-q3xl-gguf
MODEL=$MODEL_DIR/UD-Q3_K_XL/GLM-5.3-Flash-UD-Q3_K_XL-00001-of-00004.gguf
DOWNLOAD_PATTERNS="UD-Q3_K_XL/*.gguf"

CUDA_VISIBLE_DEVICES=0,1,2,3
TENSOR_SPLIT=1,1,1,1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=1.0
TOP_P=0.95
MIN_P=0.0
CHAT_TEMPLATE_KWARGS='{"reasoning_effort":"max"}'

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
