PROFILE_DESCRIPTION="Q4_K_M four-GPU layer split with DFlash"
BACKEND=llama.cpp

HF_REPO=poolside/Laguna-S-2.1-GGUF
MODEL_DIR=/home/algore/models/laguna-s-2.1-gguf
MODEL=$MODEL_DIR/laguna-s-2.1-Q4_K_M.gguf
DRAFT_MODEL=$MODEL_DIR/laguna-s-2.1-DFlash-BF16.gguf
DOWNLOAD_PATTERNS="laguna-s-2.1-Q4_K_M.gguf|laguna-s-2.1-DFlash-BF16.gguf"

CUDA_VISIBLE_DEVICES=0,1,2,3
TENSOR_SPLIT=1,1,1,1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=1.0
TOP_P=0.95
MIN_P=0.0
CHAT_TEMPLATE_KWARGS='{"enable_thinking":true}'

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=draft-dflash
SPEC_DRAFT_N_MAX=15
SPEC_DRAFT_NGL=99
SPEC_DRAFT_OVERRIDE_TENSOR='.*=CUDA0'
