PROFILE_DESCRIPTION="Q2_K on the GPU 0-1 NVLink pair"
BACKEND=llama.cpp

HF_REPO=DevQuasar/MiniMaxAI.MiniMax-M2.5-GGUF
MODEL_DIR=/home/algore/models/minimax-m2.5-q2k-gguf
MODEL=$MODEL_DIR/MiniMaxAI.MiniMax-M2.5.Q2_K-00001-of-00006.gguf
DOWNLOAD_PATTERNS="MiniMaxAI.MiniMax-M2.5.Q2_K-*.gguf"

CUDA_VISIBLE_DEVICES=0,1
TENSOR_SPLIT=1,1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=32768
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=40
MIN_P=0.0

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
