PROFILE_DESCRIPTION="Dynamic Q4_K_XL on GPU 0"
BACKEND=llama.cpp

HF_REPO=meta-models/Muse-Glimmer-30B-GGUF
MODEL_DIR=/home/algore/models/muse-glimmer-30b-gguf
MODEL=$MODEL_DIR/Muse-Glimmer-30B-KQuant-Dynamic-Q4_K_XL.gguf
DOWNLOAD_PATTERNS="Muse-Glimmer-30B-KQuant-Dynamic-Q4_K_XL.gguf"

CUDA_VISIBLE_DEVICES=0
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=131072
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
MIN_P=0.0
CHAT_TEMPLATE_KWARGS='{"reasoning_strength":"high"}'

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
