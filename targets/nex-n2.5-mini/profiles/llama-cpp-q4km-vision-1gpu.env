PROFILE_DESCRIPTION="Q4_K_M with F16 vision projector on one RTX 8000"
BACKEND=llama.cpp

HF_REPO=abenzerps/Nex-N2.5-mini-GGUF
MODEL_DIR=/home/algore/models/nex-n2.5-mini-gguf
MODEL=$MODEL_DIR/Nex-N2.5-mini-Q4_K_M.gguf
MMPROJ=$MODEL_DIR/mmproj-Nex-N2.5-mini-F16.gguf
DOWNLOAD_PATTERNS="Nex-N2.5-mini-Q4_K_M.gguf|mmproj-Nex-N2.5-mini-F16.gguf"

CUDA_VISIBLE_DEVICES=0
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=0.7
TOP_P=0.95
TOP_K=20
MIN_P=0.0

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
