PROFILE_DESCRIPTION="Fastest single-request decode: Unsloth Q4_K_M GGUF on 2 NVLink-paired GPUs (0,1)"

# Override the target default (vLLM) to run the GGUF build of llama.cpp.
BACKEND=llama.cpp

# Same single-file Unsloth Q4_K_M GGUF as llama-cpp-q4km (45.20 GiB, no split).
HF_REPO=unsloth/Qwen3-Coder-Next-GGUF
MODEL_DIR=/home/algore/models/qwen3-coder-next-80b-a3b-gguf
MODEL=$MODEL_DIR/Qwen3-Coder-Next-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3-Coder-Next-Q4_K_M.gguf"

# Single session for lowest latency; large prefill batch for prompt throughput.
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

# --- Prompt/prefix caching (identical to llama-cpp-q4km) ---------------------
# See llama-cpp-q4km.env and PERFORMANCE.md for the rationale behind each knob.
CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1

# No speculative draft model is published for Qwen3-Coder-Next.
DSPARK=0

# --- Two-GPU NVLink-pair layer split -----------------------------------------
# Measured 2026-08-07 (see PERFORMANCE.md): restricting to the NVLink-bonded
# pair 0-1 gives the fastest single-request DECODE (llama-bench 100.4 tok/s vs
# the 4-GPU 88.5 tok/s, +13.5%), at the cost of long-prefill throughput (4096
# prefill 2098.9 vs 2820.0 tok/s on 4 GPUs, -25.6%). Use this profile when the
# workload is decode-bound (short prompts, long generations); keep the 4-GPU
# `llama-cpp-q4km` default for long coding-agent prompts.
#
# CUDA_VISIBLE_DEVICES is set by the hardware profile (0,1,2,3) and re-set here.
# Profile env files load LAST in scripts/lib/common.sh, so this override wins for
# this profile only and does not affect other profiles or targets. TENSOR_SPLIT
# must match the number of VISIBLE devices (2), not the physical GPU count.
CUDA_VISIBLE_DEVICES=0,1
SPLIT_MODE=layer
TENSOR_SPLIT=1,1
FLASH_ATTN=on
