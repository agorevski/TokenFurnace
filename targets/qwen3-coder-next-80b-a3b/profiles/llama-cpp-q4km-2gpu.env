PROFILE_DESCRIPTION="Default: fastest single-request decode — Unsloth Q4_K_M GGUF on 2 NVLink-paired GPUs (0,1)"

# Override the target default (vLLM) to run the GGUF build of llama.cpp.
BACKEND=llama.cpp

# Same single-file Unsloth Q4_K_M GGUF as llama-cpp-q4km (45.20 GiB, no split).
HF_REPO=unsloth/Qwen3-Coder-Next-GGUF
MODEL_DIR=/home/algore/models/qwen3-coder-next-80b-a3b-gguf
MODEL=$MODEL_DIR/Qwen3-Coder-Next-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3-Coder-Next-Q4_K_M.gguf"

# Single session for lowest latency; large prefill batch for prompt throughput.
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

# --- Prompt/prefix caching (identical to llama-cpp-q4km) ---------------------
# See llama-cpp-q4km.env and PERFORMANCE.md for the rationale behind each knob.
CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1

# No speculative draft model is published for Qwen3-Coder-Next.
DSPARK=0

# --- Two-GPU NVLink-pair layer split (the target default) --------------------
# Measured 2026-08-07 (see PERFORMANCE.md): restricting to the NVLink-bonded
# pair 0-1 gives the fastest single-request DECODE (llama-bench 100.43 tok/s vs
# the 4-GPU 88.5 tok/s, +13.5%), at the cost of long-prefill throughput (4096
# prefill 2098.9 vs 2820.0 tok/s on 4 GPUs, -25.6%). This is now the TARGET
# DEFAULT because interactive coding turns are decode-bound once the system
# prompt is prefix-cached; use the explicit `llama-cpp-q4km` (4-GPU) profile when
# raw long-prompt prefill throughput matters more than decode latency.
#
# An empirical 2-GPU tuning sweep on 2026-08-07 (b10298/sm_75, llama-bench -r 5)
# confirmed these plain layer-split settings are the fastest SAFE configuration;
# every experimental knob tested was neutral or harmful and is therefore NOT set:
#   * CUDA_SCALE_LAUNCH_QUEUES=4x  -> within noise but slower than unset
#                                     (pp4096 1658 vs 1705, tg 91.2 vs 92.7);
#                                     explicitly unset for this profile.
#   * -sm tensor                   -> loads, but decode -13% (80.6 vs 92.7 tok/s)
#                                     and prefill no better; rejected.
#   * UBATCH_SIZE 512/1024/2048/4096 -> 2048 is optimal; pp4096 rises 1107 ->
#                                     1329 -> 1705 across 512/1024/2048, and 4096
#                                     FAILS to create the compute context. Kept 2048.
#   * THREADS/POLL (8 vs 18, 50 vs 100) -> differences are thermal-ordering noise
#                                     for this GPU-bandwidth-bound decode; unset.
#   * GGML_CUDA_P2P=1              -> no gain (pp4096 1703, tg 92.0) and upstream
#                                     warns of corruption/crashes; left unset.
# F16 KV is kept (no CACHE_TYPE_K/V): Q4_K_M already leaves large VRAM headroom
# and no long-context Q8 test justified trading quality for unused VRAM.
CUDA_SCALE_LAUNCH_QUEUES=
#
# CUDA_VISIBLE_DEVICES is set by the hardware profile (0,1,2,3) and re-set here.
# Profile env files load LAST in scripts/lib/common.sh, so this override wins for
# this profile only and does not affect other profiles or targets. TENSOR_SPLIT
# must match the number of VISIBLE devices (2), not the physical GPU count; the
# llama.cpp backend now fails fast if the two counts disagree.
CUDA_VISIBLE_DEVICES=0,1
SPLIT_MODE=layer
TENSOR_SPLIT=1,1
FLASH_ATTN=on
