PROFILE_DESCRIPTION="Fastest single-request decode: Unsloth Q4_K_M GGUF on llama.cpp (sm_75)"

# Override the target default (vLLM) to run the GGUF build of llama.cpp.
BACKEND=llama.cpp

# Unsloth GGUF distribution. Q4_K_M ships as a SINGLE file (45.20 GiB), so no
# gguf-split merge step is required; larger quants (Q8_0, BF16) are multi-shard.
HF_REPO=unsloth/Qwen3-Coder-Next-GGUF
MODEL_DIR=/home/algore/models/qwen3-coder-next-80b-a3b-gguf
MODEL=$MODEL_DIR/Qwen3-Coder-Next-Q4_K_M.gguf
# Exact filename so only the single Q4_K_M file is fetched (not UD-Q4_K_M etc.).
DOWNLOAD_PATTERNS="Qwen3-Coder-Next-Q4_K_M.gguf"

# Single session for lowest latency; large prefill batch for prompt throughput.
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

# --- Prompt/prefix caching (long coding-agent system prompts) ----------------
# Copilot/Claude Code send a large, stable system prompt + tool schema on every
# turn. Caching that prefix skips re-prefilling it, which is the dominant cost
# for short follow-up messages. See PERFORMANCE.md for verification commands.
#
#   CACHE_PROMPT=1            prompt caching stays on (server default; explicit
#                            here for clarity).
#   CACHE_RAM_MIB=32768       host-RAM prompt cache. 32 GiB is safe on this
#                            251 GiB host: Q4_K_M weights are 45 GiB resident in
#                            VRAM (not host RAM), so the cache competes only with
#                            OS/page cache. Raise toward -1 (no limit) only if
#                            you monitor host RAM; lower it if other services run.
#   CACHE_IDLE_SLOTS=1        keep the idle slot's KV in the prompt cache between
#                            turns (server default; requires cache-ram).
#   CACHE_REUSE=256           reuse cached chunks >=256 tokens via KV shifting
#                            even when the prefix only partially matches. 0 (the
#                            server default) disables partial reuse.
#   SLOT_PROMPT_SIMILARITY=0.01  with PARALLEL=1 there is a single slot, so a low
#                            similarity threshold lets the one interactive
#                            session reattach to its slot instead of evicting it.
#   ENABLE_METRICS=1          expose the Prometheus /metrics endpoint so cache
#                            reuse can be verified (see PERFORMANCE.md).
CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1

# No speculative draft model is published for Qwen3-Coder-Next.
DSPARK=0

# Split/attention tuning knobs (see PERFORMANCE.md). Defaults chosen to load
# reliably on sm_75; benchmark alternatives before adopting:
#   SPLIT_MODE=row        # row split can help on the NVLink-pair topology
#   CACHE_TYPE_K=q8_0     # Q8 KV cache to extend context headroom
#   CACHE_TYPE_V=q8_0
SPLIT_MODE=layer
TENSOR_SPLIT=1,1,1,1
FLASH_ATTN=on
