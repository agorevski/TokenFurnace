PROFILE_DESCRIPTION="Fastest single-request decode: Unsloth Q4_K_M GGUF on llama.cpp (sm_75)"

# Override the target default (vLLM) to run the GGUF build of llama.cpp.
BACKEND=llama.cpp

# Unsloth GGUF distribution. Q4_K_M ships as a SINGLE file (45.20 GiB), so no
# gguf-split merge step is required; larger quants (Q8_0, BF16) are multi-shard.
HF_REPO=unsloth/Qwen3-Coder-Next-GGUF
MODEL_DIR=/home/algore/models/qwen3-coder-next-80b-a3b-gguf
MODEL=$MODEL_DIR/Qwen3-Coder-Next-Q4_K_M.gguf
# Exact filename so only the single Q4_K_M file is fetched (not UD-Q4_K_M etc.).
DOWNLOAD_PATTERNS="Qwen3-Coder-Next-Q4_K_M.gguf"

# Single session for lowest latency; large prefill batch for prompt throughput.
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

# No speculative draft model is published for Qwen3-Coder-Next.
DSPARK=0

# Split/attention tuning knobs (see PERFORMANCE.md). Defaults chosen to load
# reliably on sm_75; benchmark alternatives before adopting:
#   SPLIT_MODE=row        # row split can help on the NVLink-pair topology
#   CACHE_TYPE_K=q8_0     # Q8 KV cache to extend context headroom
#   CACHE_TYPE_V=q8_0
SPLIT_MODE=layer
TENSOR_SPLIT=1,1,1,1
FLASH_ATTN=on
