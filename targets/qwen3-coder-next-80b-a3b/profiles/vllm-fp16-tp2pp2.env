PROFILE_DESCRIPTION="Topology-aware vLLM FP16: TP2 within each NVLink pair, PP2 across pairs"
MODEL=$MODEL_DIR
DTYPE=half

# TP groups (0,1) and (2,3) map onto the two NVLink pairs; the slow cross-pair
# PCIe path carries only pipeline-stage activations instead of every
# tensor-parallel all-reduce.
TENSOR_PARALLEL_SIZE=2
PIPELINE_PARALLEL_SIZE=2

MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.94

# Concurrency knobs for aggregate serving throughput (single-number latency is
# not the goal of this profile).
MAX_NUM_SEQS=64

# --- Automatic prefix caching (APC) ------------------------------------------
# Off by default in vLLM for the Qwen3-Next hybrid model. Enabling it lets long,
# stable coding-agent system prompts be reused across requests. "align" is the
# experimental Mamba cache mode required for the GatedDeltaNet layers; sha256 is
# the default, collision-resistant prefix hash. KV cache dtype stays auto/FP16
# on Turing (no FP8). Prefix matching is exact and is not a security boundary;
# keep this to a single trusted server/user.
ENABLE_PREFIX_CACHING=1
MAMBA_CACHE_MODE=align
PREFIX_CACHING_HASH_ALGO=sha256

ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
ENFORCE_EAGER=0
