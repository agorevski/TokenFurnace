PROFILE_DESCRIPTION="Initial FP16 vLLM baseline across four RTX 8000 GPUs"
MODEL=$MODEL_DIR
DTYPE=half
TENSOR_PARALLEL_SIZE=4
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.94

# Automatic prefix caching (off by default for the Qwen3-Next hybrid model).
# "align" is the experimental Mamba cache mode required by the GatedDeltaNet
# layers; sha256 is the default prefix hash. KV cache dtype stays auto/FP16 on
# Turing. Exact-prefix reuse only; single trusted server/user.
ENABLE_PREFIX_CACHING=1
MAMBA_CACHE_MODE=align
PREFIX_CACHING_HASH_ALGO=sha256

ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
ENFORCE_EAGER=0
