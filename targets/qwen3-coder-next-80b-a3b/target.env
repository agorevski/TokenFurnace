TARGET_NAME="Qwen3-Coder-Next 80B-A3B"
BACKEND=vllm
DEFAULT_PROFILE=llama-cpp-q4km-2gpu
MODEL_ALIAS=qwen3-coder-next
MODEL_DIR=/home/algore/models/qwen3-coder-next-80b-a3b
HF_REPO=Qwen/Qwen3-Coder-Next
VLLM_ENV=/home/algore/miniconda3/envs/vllm
# Port 8000 on this host is already bound by an unrelated Docker service (see
# `ss -ltnp | grep 8000`), so the Qwen server defaults to 8090 to avoid a bind
# conflict. Setting it here (instead of appending `--port 8090` on the command
# line) keeps a single, non-duplicated `--port` flag and makes every wrapper —
# serve-model.sh, status.sh, benchmark-model.sh, copilot-local.sh,
# claude-local.sh — resolve the same port with no manual override.
SERVER_PORT=8090

# Shared llama.cpp build (reused from the DeepSeek target; sm_75, CUDA, NCCL).
# Consumed only by profiles that override BACKEND to llama.cpp.
LLAMA_DIR=/home/algore/llama.cpp-dspark-current
BUILD_DIR=/home/algore/llama.cpp-dspark-current/build-peer2048
