PROFILE_DESCRIPTION="A/B baseline: single-GPU Q4_K_M without MTP speculation"
BACKEND=llama.cpp

HF_REPO=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
MODEL_DIR=/home/algore/models/qwen3.6-35b-a3b-mtp-gguf
MODEL=$MODEL_DIR/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3.6-35B-A3B-UD-Q4_K_M.gguf"

CUDA_VISIBLE_DEVICES=2
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

SPEC_TYPE=
CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
