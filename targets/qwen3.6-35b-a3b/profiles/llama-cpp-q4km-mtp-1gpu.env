PROFILE_DESCRIPTION="Fastest interactive path: Unsloth Q4_K_M with in-model MTP on one RTX 8000"
BACKEND=llama.cpp

HF_REPO=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
MODEL_DIR=/home/algore/models/qwen3.6-35b-a3b-mtp-gguf
MODEL=$MODEL_DIR/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3.6-35B-A3B-UD-Q4_K_M.gguf"

# The 21.10 GiB model fits on one 48 GiB card. Keeping decode local avoids
# NVLink/PCIe synchronization and leaves GPUs 0-1 available for the 80B target.
CUDA_VISIBLE_DEVICES=2
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

# Qwen3.6 carries an MTP prediction head in this GGUF. Two draft tokens is the
# publisher's recommended llama.cpp setting; measure the no-MTP profile when
# acceptance is workload-dependent.
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=2

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
