PROFILE_DESCRIPTION="Single-GPU baseline: OrcaRouter Q4_K_M on one RTX 8000"
BACKEND=llama.cpp

HF_REPO=chimingw/Qwen3.8-27B-Uncensored-OrcaRouter-GGUF
MODEL_DIR=/home/algore/models/qwen3.8-27b-orcarouter-gguf
MODEL=$MODEL_DIR/Qwen3.8-27B-Uncensored-OrcaRouter-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3.8-27B-Uncensored-OrcaRouter-Q4_K_M.gguf"

CUDA_VISIBLE_DEVICES=3
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
