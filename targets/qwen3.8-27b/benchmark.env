# GPU 3 cold-prefill comparison shared by the 262K llama.cpp and vLLM profiles.
BENCHMARK_NAME=qwen3.8-27b-gpu3-cold-prefill

# Both servers expose the model's full native context and the same prefill
# batch-token cap. vLLM does not expose a direct UBATCH_SIZE equivalent, so
# record that mapping as unmapped when documenting strict comparability.
BENCHMARK_CONTEXT_SIZE=262144
BENCHMARK_BATCH_SIZE=8192
BENCHMARK_UBATCH_SIZE=2048

# Native llama.cpp sweep.
BENCHMARK_PREFILL_TOKENS_SHORT=512
BENCHMARK_PREFILL_TOKENS_LONG=4096
BENCHMARK_OUTPUT_TOKENS=128
BENCHMARK_REPETITIONS=5

# One cold 32K prompt followed by a fixed 1K decode. The separate one-token
# output limit isolates prefill-oriented API measurements.
BENCHMARK_API_PROMPT_FILE=targets/qwen3.8-27b/benchmark-prompt.txt
BENCHMARK_API_PROMPT_SHA256=24a8b4877ce617a49b04a55f3a1e6dabc61664e9060a68c33442fc5c9893af29
BENCHMARK_API_PROMPT_TOKENS=32768
BENCHMARK_API_OUTPUT_TOKENS=1024
BENCHMARK_API_PREFILL_OUTPUT_TOKENS=1
BENCHMARK_API_CONCURRENCY=1
BENCHMARK_API_REQUESTS=1
BENCHMARK_TEMPERATURE=0
BENCHMARK_CACHE_STATE=cold
