PROFILE_DESCRIPTION="GPU 3 Q4_K_M 262K-context cold-prefill benchmark"
BACKEND=llama.cpp

HF_REPO=unsloth/Qwen3.8-27B-GGUF
MODEL_DIR=/home/algore/models/qwen3.8-27b-gguf
MODEL=$MODEL_DIR/Qwen3.8-27B-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3.8-27B-Q4_K_M.gguf"

CUDA_VISIBLE_DEVICES=3
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=262144
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

CACHE_PROMPT=0
CACHE_IDLE_SLOTS=0
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
