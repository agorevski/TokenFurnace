PROFILE_DESCRIPTION="Full 262K context: tensor-parallel Q4_K_M on NVLink pair 2-3"
BACKEND=llama.cpp

HF_REPO=unsloth/Qwen3.8-27B-GGUF
MODEL_DIR=/home/algore/models/qwen3.8-27b-gguf
MODEL=$MODEL_DIR/Qwen3.8-27B-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3.8-27B-Q4_K_M.gguf"

CUDA_VISIBLE_DEVICES=2,3
TENSOR_SPLIT=1,1
SPLIT_MODE=tensor
FLASH_ATTN=on
CTX_SIZE=262144
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048
CACHE_PROMPT=1
# llama.cpp has no TTL knob. Keep up to 128 GiB of reusable KV prefixes so
# inactive sessions can remain warm for a 24-hour operating window unless LRU
# pressure or a server restart evicts them.
CACHE_RAM_MIB=131072
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
