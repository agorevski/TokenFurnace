PROFILE_DESCRIPTION="8192-token NVLink pair control for four-GPU comparisons"
BACKEND=llama.cpp

HF_REPO=unsloth/Qwen3.8-27B-GGUF
MODEL_DIR=/home/algore/models/qwen3.8-27b-gguf
MODEL=$MODEL_DIR/Qwen3.8-27B-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3.8-27B-Q4_K_M.gguf"

CUDA_VISIBLE_DEVICES=2,3
TENSOR_SPLIT=1,1
SPLIT_MODE=tensor
FLASH_ATTN=on
CTX_SIZE=8192
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048
CACHE_PROMPT=1
CACHE_RAM_MIB=131072
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
