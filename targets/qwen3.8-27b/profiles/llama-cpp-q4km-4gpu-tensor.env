PROFILE_DESCRIPTION="Four-GPU Q4_K_M tensor split across both NVLink pairs"
BACKEND=llama.cpp

HF_REPO=unsloth/Qwen3.8-27B-GGUF
MODEL_DIR=/home/algore/models/qwen3.8-27b-gguf
MODEL=$MODEL_DIR/Qwen3.8-27B-Q4_K_M.gguf
DOWNLOAD_PATTERNS="Qwen3.8-27B-Q4_K_M.gguf"

CUDA_VISIBLE_DEVICES=0,1,2,3
GGML_CUDA_P2P=1
TENSOR_SPLIT=1,1,1,1
SPLIT_MODE=tensor
FLASH_ATTN=on
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16
CTX_SIZE=8192
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048
CACHE_PROMPT=1
CACHE_RAM_MIB=131072
CACHE_IDLE_SLOTS=1
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
