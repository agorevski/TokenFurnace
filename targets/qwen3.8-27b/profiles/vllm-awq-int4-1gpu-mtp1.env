PROFILE_DESCRIPTION="Single-GPU vLLM W4A16 AWQ on GPU 1 with built-in MTP-1"
BACKEND=vllm

HF_REPO=philbert440/Qwen3.8-27B-W4A16-AWQ
MODEL_DIR=/home/algore/models/qwen3.8-27b-awq-int4
MODEL=$MODEL_DIR
SERVER_PORT=8098

VLLM_ENV=/home/algore/miniconda3
DTYPE=half
KV_CACHE_DTYPE=auto
CUDA_VISIBLE_DEVICES=1
TENSOR_PARALLEL_SIZE=1
PIPELINE_PARALLEL_SIZE=1
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.94
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192

VLLM_USE_FLASHINFER_SAMPLER=0
ATTENTION_BACKEND=TRITON_ATTN
CC=/usr/bin/gcc-13
CXX=/usr/bin/g++-13
FLASHINFER_EXTRA_LDFLAGS=-L/home/algore/miniconda3/lib

LANGUAGE_MODEL_ONLY=1
ENABLE_EXPERT_PARALLEL=0
ENABLE_PREFIX_CACHING=1
MAMBA_CACHE_MODE=align
PREFIX_CACHING_HASH_ALGO=sha256
REASONING_PARSER=qwen3
DEFAULT_CHAT_TEMPLATE_KWARGS='{"reasoning_effort":"medium"}'
GENERATION_CONFIG=vllm
OVERRIDE_GENERATION_CONFIG='{"temperature":0,"max_new_tokens":4096}'
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":1}'
ENFORCE_EAGER=0
