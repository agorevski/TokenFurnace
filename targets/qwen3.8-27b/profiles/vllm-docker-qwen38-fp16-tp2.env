PROFILE_DESCRIPTION="Dedicated qwen38 vLLM image, official weights cast to FP16, TP2 on NVLink pair 2-3"
BACKEND=vllm-docker

HF_REPO=Qwen/Qwen3.8-27B
MODEL_DIR=/home/algore/models/qwen3.8-27b-official
MODEL=$MODEL_DIR

DOCKER_IMAGE=vllm/vllm-openai:qwen38
DOCKER_MODEL_PATH=/model
DOCKER_CONTAINER_NAME=tokenfurnace-qwen38
DOCKER_CACHE_DIR=/home/algore/.cache/vllm-qwen38
# Docker is installed without NVIDIA Container Toolkit on this host. Pass the
# selected GPU devices and host driver libraries directly instead.
DOCKER_GPU_MODE=direct

DTYPE=half
KV_CACHE_DTYPE=auto
CUDA_VISIBLE_DEVICES=2,3
TENSOR_PARALLEL_SIZE=2
PIPELINE_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.94
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192

VLLM_USE_FLASHINFER_SAMPLER=0
ATTENTION_BACKEND=TRITON_ATTN
CC=/usr/bin/gcc
CXX=/usr/bin/g++

LANGUAGE_MODEL_ONLY=1
ENABLE_PREFIX_CACHING=1
MAMBA_CACHE_MODE=align
PREFIX_CACHING_HASH_ALGO=sha256
REASONING_PARSER=qwen3
DEFAULT_CHAT_TEMPLATE_KWARGS='{"reasoning_effort":"medium"}'
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_xml
SPECULATIVE_CONFIG=
ENFORCE_EAGER=0
