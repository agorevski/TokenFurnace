PROFILE_DESCRIPTION="Official FP16 TP2 with built-in MTP-2"
BACKEND=vllm

HF_REPO=Qwen/Qwen3.8-27B
MODEL_DIR=/home/algore/models/qwen3.8-27b-official
MODEL=$MODEL_DIR

VLLM_ENV=/home/algore/miniconda3
DTYPE=half
# Triton requires "auto" for unquantized KV; with DTYPE=half this is FP16.
KV_CACHE_DTYPE=auto
CUDA_VISIBLE_DEVICES=2,3
TENSOR_PARALLEL_SIZE=2
PIPELINE_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.94
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192

VLLM_USE_FLASHINFER_SAMPLER=0
ATTENTION_BACKEND=TRITON_ATTN
CC=/usr/bin/gcc-13
CXX=/usr/bin/g++-13
FLASHINFER_EXTRA_LDFLAGS=-L/home/algore/miniconda3/lib

LANGUAGE_MODEL_ONLY=1
ENABLE_EXPERT_PARALLEL=0
# APC has no TTL; cached KV blocks remain reusable until eviction or restart.
ENABLE_PREFIX_CACHING=1
MAMBA_CACHE_MODE=align
PREFIX_CACHING_HASH_ALGO=sha256
REASONING_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":2}'
ENFORCE_EAGER=0
