PROFILE_DESCRIPTION="Official unquantized safetensors, runtime-cast BF16 to FP16, TP2 on NVLink pair 2-3"
BACKEND=vllm

HF_REPO=Qwen/Qwen3.8-27B
MODEL_DIR=/home/algore/models/qwen3.8-27b-official
MODEL=$MODEL_DIR

# vLLM 0.21 recognizes Qwen3_5ForConditionalGeneration and is newer than the
# conservative 0.17 environment used by older targets.
VLLM_ENV=/home/algore/miniconda3
DTYPE=half
CUDA_VISIBLE_DEVICES=2,3
TENSOR_PARALLEL_SIZE=2
PIPELINE_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.94
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192

# FlashInfer's sampler JIT in this environment selects Conda GCC 15, which CUDA
# 13 rejects. Use vLLM's native sampler and the Turing-compatible Triton
# attention backend; neither changes model weights or arithmetic precision.
VLLM_USE_FLASHINFER_SAMPLER=0
ATTENTION_BACKEND=TRITON_ATTN
CC=/usr/bin/gcc-13
CXX=/usr/bin/g++-13
# FlashInfer's JIT assumes CUDA runtime libraries live under $CUDA_HOME/lib64,
# while this Conda CUDA installation places libcudart under $CUDA_HOME/lib.
FLASHINFER_EXTRA_LDFLAGS=-L/home/algore/miniconda3/lib

# Text-only testing removes the vision tower but does not quantize or replace
# any language-model weight. Prefix caching stays off for cache-cold profiling.
LANGUAGE_MODEL_ONLY=1
ENABLE_EXPERT_PARALLEL=0
ENABLE_PREFIX_CACHING=0
REASONING_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
SPECULATIVE_CONFIG=
ENFORCE_EAGER=0
