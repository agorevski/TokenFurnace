PROFILE_DESCRIPTION="Official Q8_0 GGUF on one RTX 8000"
BACKEND=llama.cpp

HF_REPO=XHToken/Spark-X2.5-4B-GGUF
MODEL_DIR=/home/algore/models/spark-x2.5-4b-gguf
MODEL=$MODEL_DIR/Spark-X2.5-4B-Q8_0.gguf
DOWNLOAD_PATTERNS="Spark-X2.5-4B-Q8_0.gguf"

CUDA_VISIBLE_DEVICES=0
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=0
MIN_P=0.0
CHAT_TEMPLATE_KWARGS='{"enable_thinking":true}'

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
