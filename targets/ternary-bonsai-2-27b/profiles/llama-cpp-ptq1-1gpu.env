PROFILE_DESCRIPTION="Dense-trit PTQ1_0 pack on one RTX 8000 for bandwidth-bound decode"
BACKEND=llama.cpp

HF_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
MODEL_DIR=/home/algore/models/ternary-bonsai-2-27b-gguf
MODEL=$MODEL_DIR/Ternary-Bonsai-2-27B-PTQ1_0.gguf
DOWNLOAD_PATTERNS="Ternary-Bonsai-2-27B-PTQ1_0.gguf"

CUDA_VISIBLE_DEVICES=3
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=8192
UBATCH_SIZE=2048

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
