PROFILE_DESCRIPTION="Optimized Bonsai Squared KTQ2_1/VTQ2_2 cache on one RTX 8000"
BACKEND=llama.cpp

HF_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
MODEL_DIR=/home/algore/models/ternary-bonsai-2-27b-gguf
MODEL=$MODEL_DIR/Ternary-Bonsai-2-27B-PQ2_0.gguf
DOWNLOAD_PATTERNS="Ternary-Bonsai-2-27B-PQ2_0.gguf"

LLAMA_DIR=/home/algore/GIT/agorevski/TokenFurnace-TurboQuant-TernaryBonsai-2-27b
BUILD_DIR=$LLAMA_DIR/build-cuda
MODEL_ALIAS=ternary-bonsai-2-27b-turboquant
SERVER_PORT=8101

CUDA_VISIBLE_DEVICES=0
TENSOR_SPLIT=1
SPLIT_MODE=layer
FLASH_ATTN=on
CTX_SIZE=65536
PARALLEL=1
BATCH_SIZE=2048
UBATCH_SIZE=512

CACHE_TYPE_K=ktq2_1
CACHE_TYPE_V=vtq2_2

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
REASONING=on
REASONING_EFFORT=medium

CACHE_PROMPT=1
CACHE_RAM_MIB=32768
CACHE_IDLE_SLOTS=1
CACHE_REUSE=256
SLOT_PROMPT_SIMILARITY=0.01
ENABLE_METRICS=1
CUDA_SCALE_LAUNCH_QUEUES=
SPEC_TYPE=
